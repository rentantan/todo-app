# 開発時は True。本番では必ず False にし、SECRET_KEY を設定すること
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# カンマ区切り
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 未設定なら SQLite (backend/db.sqlite3) を使用
# DATABASE_URL=postgresql://todoapp_user:todoapp_password@localhost:5432/todoapp_db

# JWT の有効期限
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ログイン・登録の回数制限（IP ごと）
AUTH_THROTTLE_RATE=10/min
